# Build
bin/
obj/
TestResults/
*.user
*.suo
.vs/
.idea/

# Runtime output — never commit job output, logs or secrets.
# Job output folders are matched only under job folders: git on Windows ignores case,
# so a bare "output/" would also hide the src/**/Output/ code folders.
samples/jobs/*/output/
samples/poc/jobs/*/output/
tests/fixtures/jobs/*/output/
/logs/
# Development data (appsettings.Development.json: ledger, job index, qb-lists, logs)
src/QbAutopost.Api/data/
*.tmp
.env
deploy/hermes/provider.env
appsettings.*.local.json

# POC package build output (scripts/build-poc-package.ps1)
/dist/

# T-910 (api-v1 FR-A-13): per-caller keys. Holds salted hashes only, never a key, but it is per-deployment
# data and must never reach the repository.
clients.json
