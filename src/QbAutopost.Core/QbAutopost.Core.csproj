<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform. MUST NOT reference COM (CLAUDE.md hard rule 2, ADR-0001). -->
  <PropertyGroup>
    <RootNamespace>QbAutopost.Core</RootNamespace>
  </PropertyGroup>

  <!-- Prompt files are read at startup from <app>/Hermes/prompts (spec §9); editable on the server. -->
  <ItemGroup>
    <None Update="Hermes\prompts\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
