# deploy/hermes/provider.env.example -> copy to deploy/hermes/provider.env (git-ignored) and fill in.
# Passed unchanged into the Hermes container only (spec Q5: the cloud provider key lives in the container).
# Placeholders only in this file. The variable names depend on the model provider and the Hermes image:
# replace the name on the left with the one your provider needs (for example the provider's *_API_KEY).
# QbAutopost never reads this file and never needs this key.

REPLACE_WITH_PROVIDER_KEY_VARIABLE=replace-with-provider-api-key
