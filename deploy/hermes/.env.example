# deploy/hermes/.env.example -> copy to deploy/hermes/.env (git-ignored) and fill in real values.
# Placeholders only in this file. Never commit the real .env.

# Hermes Agent image, with an explicit tag or digest. The spec does not name it, so there is no default
# (SPEC-GAP T-801, tracker Q-42). Take it from the Hermes documentation / the owner.
HERMES_IMAGE=replace-with-hermes-image:tag

# Port the Hermes OpenAI-compatible API listens on INSIDE the container. It is always published on
# 127.0.0.1:8642 on the host (spec section 4).
HERMES_CONTAINER_PORT=8642

# Folder inside the container where Hermes keeps its configuration and data (kept in a named volume).
HERMES_DATA_PATH=/replace-with-hermes-data-path

# Required. A long random value; QbAutopost sends it as its Hermes key (QBAUTOPOST__Hermes__ApiKey).
# PowerShell: -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 48 | ForEach-Object { [char]$_ })
API_SERVER_KEY=replace-with-long-random-key

# Optional. Container memory cap (Docker size syntax). WSL 2 also needs a .wslconfig cap, see README-hermes.md.
HERMES_MEMORY_LIMIT=4g
